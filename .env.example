# Supabase server connection. Never expose the secret key in NEXT_PUBLIC variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SESSION_HASH_SECRET=generate_at_least_32_random_characters
ADMIN_MFA_ENCRYPTION_KEY=generate_a_separate_32_character_secret
# Comma-separated Discord user IDs allowed to bootstrap as Nexbiy super admins.
# Keep this server-only and remove IDs when staff access is revoked.
SUPER_ADMIN_DISCORD_IDS=your_discord_user_id

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3010/api/auth/callback/discord
